{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ingest": {
    "AgentIds": [ "<AURA agent id>" ],
    "DefaultMailbox": "traded",
    "MaxEmlSizeBytes": 52428800
  },
  "AiReceiver": {
    "BaseUrl": "http://localhost:5200",
    "SubmissionsPath": "/api/ai/submissions",
    "TimeoutSeconds": 100
  }
}
