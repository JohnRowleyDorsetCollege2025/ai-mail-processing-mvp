@inherits LayoutComponentBase
@implements IDisposable
@inject AnnotationState Annotations

@if (!Annotations.Enabled)
{
    <div class="annotation-bar">
        <span><b class="tag">P</b> Permissions</span>
        <span><b class="tag">A</b> Audit trail</span>
        <span><b class="tag">R</b> Retention</span>
    </div>
}

<div class="app-shell">
    <header class="app-header">
        <svg class="logo" viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="14.5" fill="none" stroke="#003781" stroke-width="2" />
            <path d="M10 22V10M14 22V10M18 22V10M22 22V10" stroke="#003781" stroke-width="2.4" />
        </svg>
        <span class="divider"></span>
        <span class="app-title">Enterprise Configurable Traded Product</span>
        <span class="spacer"></span>
        <span class="clock">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</span>
        <span class="user">User (user01)</span>
        <span class="avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="1.6"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>
        </span>
    </header>
    <main>@Body</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized() => Annotations.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Annotations.Changed -= OnChanged;
}
